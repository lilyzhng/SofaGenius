[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> # Read the Excel file
[?2004l[?2004h> xl_file = '/app/data/ConSup Inc Financial Model_PROMPT.xlsx'
[?2004l[?2004h> xl = pd.ExcelFile(xl_file)
[?2004l[?2004h> 
[?2004l[?2004h> # Function to find value by searching for a label
[?2004l[?2004h> def find_value_by_label(df, label, col_offset=1):
[?2004l[?2004h>     for idx, row in df.iterrows():
[?2004l[?2004h>         if pd.notna(row.iloc[1]) and str(row.iloc[1]).strip() == label:
[?2004l[?2004h>             return row.iloc[1 + col_offset]
[?2004l[?2004h>     return None
[?2004l[?2004h> 
[?2004l[?2004h> # Function to find value in specific location
[?2004l[?2004h> def find_value_at_location(df, row_label, col_search=None):
[?2004l[?2004h>     for idx, row in df.iterrows():
[?2004l[?2004h>         if pd.notna(row.iloc[1]) and str(row.iloc[1]).strip() == row_label:
[?2004l[?2004h>             # Look for non-NaN values in this row
[?2004l[?2004h>             for col_idx in range(2, len(row)):
[?2004l[?2004h>                 if pd.notna(row.iloc[col_idx]) and isinstance(row.iloc[col_idx], (int, float)):
[?2004l[?2004h>                     return row.iloc[col_idx]
[?2004l[?2004h>     return None
[?2004l[?2004h> 
[?2004l[?2004h> print("=== EXTRACTING KEY TRANSACTION DATA ===")
[?2004l[?2004h> 
[?2004l[?2004h> # Read sheets
