[19.69116, "i", "cat > /app/lbo_analysis.py << 'EOF'\nimport pandas as pd\nimport numpy as np\n\n# Read the Excel file\nxl_file = '/app/data/ConSup Inc Financial Model_PROMPT.xlsx'\n\n# Read all sheets\nsheets = {}\nsheet_names = ['Transaction Structure', 'Assumptions', 'Financial Statements', 'Debt', 'PP&E', 'NWC', 'Historicals']\n\nfor sheet in sheet_names:\n    try:\n        sheets[sheet] = pd.read_excel(xl_file, sheet_name=sheet)\n        print(f\"\\n=== {sheet} ===\")\n        print(f\"Shape: {sheets[sheet].shape}\")\n        print(sheets[sheet].head(10))\n    except Exception as e:\n        print(f\"Error reading {sheet}: {e}\")\n\nEOF\n"]
