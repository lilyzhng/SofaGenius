[34.777003, "i", "cat > /app/extract_data.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom openpyxl import load_workbook\n\n# Load the workbook\nwb = load_workbook('/app/data/ConSup Inc Financial Model_PROMPT.xlsx', data_only=True)\n\nprint(\"Available worksheets:\", wb.sheetnames)\n\n# Read Transaction Structure\nts_sheet = wb['Transaction Structure']\nprint(\"\\n=== Transaction Structure Data ===\")\nfor row in range(1, 20):\n    row_data = []\n    for col in range(1, 8):\n        cell_value = ts_sheet.cell(row=row, col=col).value\n        if cell_value is not None:\n            row_data.append(str(cell_value))\n    if row_data:\n        print(f\"Row {row}: {' | '.join(row_data)}\")\n\n# Read Financial Statements\nfs_sheet = wb['Financial Statements']\nprint(\"\\n=== Financial Statements Data ===\")\nfor row in range(1, 30):\n    row_data = []\n    for col in range(1, 8):\n        cell_value = fs_sheet.cell(row=row, col=col).value\n        if cell_value is not None:\n            row_data.append(str(cell_value))\n    if row_data:\n        print(f\"Row {row}: {' | '.join(row_data)}\")\n\nEOF\n"]
