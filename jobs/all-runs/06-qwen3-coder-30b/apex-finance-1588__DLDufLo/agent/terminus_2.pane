[?2004hroot@7326c35a90b6:/app# cat > /app/scripts/extract_key_data.py << 'EOF'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> from openpyxl import load_workbook
[?2004l[?2004h> 
[?2004l[?2004h> # Load the Excel file
[?2004l[?2004h> data_file = "/app/data/ConSup Inc Financial Model_PROMPT.xlsx"
[?2004l[?2004h> 
[?2004l[?2004h> # Try to extract key data from Financial Statements
[?2004l[?2004h> try:
[?2004l[?2004h>     df_financial = pd.read_excel(data_file, sheet_name="Financial Statements", header=3)
[?2004l[?2004h>     
[?2004l[?2004h>     # Let's look at column names to identify EBITDA
[?2004l[?2004h>     print("Financial Statements column names:")
[?2004l[?2004h>     for i, col in enumerate(df_financial.columns):
[?2004l[?2004h>         print(f"  {i}: {col}")
[?2004l[?2004h>     
[?2004l[?2004h>     # Find the Core Business row (which contains EBITDA data)
[?2004l[?2004h>     core_business_row = df_financial[df_financial.iloc[:, 0].str.contains('Core Business', na=False)]
[?2004l[?2004h>     if not core_business_row.empty:
[?2004l[?2004h>         print(f"\nCore Business row found at index: {core_business_row.index[0]}")
[?2004l[?2004h>         core_business_data = core_business_row.iloc[0]
[?2004l[?2004h>         print("Core Business data:")
[?2004l[?2004h>         print(core_business_data)
[?2004l[?2004h>     
[?2004l[?2004h>     # Extract the EBITDA values for FY24-FY29
[?2004l[?2004h>     # We need to look for the row that contains EBITDA data
[?2004l[?2004h>     ebitda_row = None
[?2004l[?2004h>     for idx, row in df_financial.iterrows():
[?2004l[?2004h>         if 'EBITDA' in str(row.iloc[0]) or 'Core Business' in str(row.iloc[0]):
[?2004l[?2004h>             ebitda_row = row
[?2004l[?2004h>             print(f"\nEBITDA/Core Business row found at index: {idx}")
[?2004l[?2004h>             print(row)
[?2004l[?2004h>             break
[?2004l[?2004h>     
[?2004l[?2004h>     # Look at the actual values for EBITDA in each year
[?2004l[?2004h>     print("\nExamining row data for EBITDA values:")
[?2004l[?2004h>     for idx, row in df_financial.iterrows():
[?2004l[?2004h>         if not pd.isna(row.iloc[0]) and ('EBITDA' in str(row.iloc[0]) or 'Core' in str(row.iloc[0])):
[?2004l[?2004h>             print(f"Row {idx}: {row.iloc[0]}")
[?2004l[?2004h>             # Print the data values for this row
[?2004l[?2004h>             for i in range(1, len(row)):
[?2004l[?2004h>                 if not pd.isna(row.iloc[i]):
[?2004l[?2004h>                     print(f"  Year {i}: {row.iloc[i]}")
[?2004l[?2004h>                     
[?2004l[?2004h> except Exception as e:
[?2004l[?2004h>     print(f"Error extracting financial data: {e}")
[?2004l[?2004h> 
[?2004l[?2004h> # Now extract transaction details
[?2004l[?2004h> try:
[?2004l[?2004h>     df_transaction = pd.read_excel(data_file, sheet_name="Transaction Structure", header=3)
[?2004l[?2004h>     print(f"\nTransaction Structure data:")
[?2004l[?2004h>     print(df_transaction.head(15))
[?2004l[?2004h>     
[?2004l[?2004h>     # Look for key transaction data
[?2004l[?2004h>     key_fields = ['FY24 EBITDA', 'Purchase Enterprise Value', 'Rollover Equity', 'Sponsor Equity']
[?2004l[?2004h>     for field in key_fields:
[?2004l[?2004h>         field_row = df_transaction[df_transaction.iloc[:, 0].str.contains(field, na=False)]
[?2004l[?2004h>         if not field_row.empty:
[?2004l[?2004h>             print(f"\n{field}: {field_row.iloc[0].iloc[1]}")
[?2004l[?2004h>             
[?2004l[?2004h> except Exception as e:
[?2004l[?2004h>     print(f"Error extracting transaction data: {e}")
