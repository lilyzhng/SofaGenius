[?2004litda'], [?2004h>     ebit_margin = 0.12  # EBIT margin 12% (using EBIT as defined on page 33 of 10-K)
[?2004l[?2004h>     tax_rate = 0.22  # Effective Tax Rate 22%
[?2004l[?2004h>     deprecation_amortization_revenue = 0.02  # D&A/Revenue 2%
[?2004l[?2004h>     capex_revenue = 0.04  # CapEx/Revenue 4%
[?2004l[?2004h>     nwc_revenue = 0.01  # Change in NWC/Revenue 1%
[?2004l[?2004h>     
[?2004l[?2004h>     # WACC and Terminal Growth Rate (as mentioned in task)
[?2004l[?2004h>     wacc = 0.0688
[?2004lite("=====[?2004h>     terminal_growth_rate = 0.0380
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate projected revenues for 3 years
[?2004l[?2004h>     project_revenue = [
[?2004l[?2004h>         revenue_2025_valuation,
[?2004l[?2004h>         revenue_2025_valuation * (1 + cagr),
[?2004l[?2004h>         revenue_2025_valuation * (1 + cagr) ** 2,
[?2004l[?2004h>         revenue_2025_valuation * (1 + cagr) ** 3
[?2004l[?2004h>     ]
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate EBIT for each year
[?2004l[?2004h>     project_ebit = [r * ebit_margin for r in project_revenue]
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate tax and NOPAT for each year
[?2004l[?2004h>     project_tax = [e * tax_rate for e in project_ebit]
[?2004l[?2004h>     project_nopat = [e - t for e, t in zip(project_ebit, project_tax)]
[?2004l'][?2004h>     
[?2004l)[?2004h>     # Calculate FCF for each year
[?2004l[?2004h>     project_d_a = [r * deprecation_amortization_revenue for r in project_revenue]
[?2004l[?2004h>     project_capex = [r * capex_revenue for r in project_revenue]
[?2004l[?2004h>     project_nwc = [r * nwc_revenue for r in project_revenue]
[?2004l[?2004h>     
[?2004l[?2004h>     project_fcf = [
[?2004lE[?2004h>         nopat - capex - nwc + da 
[?2004l [?2004h>         for nopat, da, capex, nwc in zip(project_nopat, project_d_a, project_capex, project_nwc)
[?2004l[?2004h>     ]
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate present value of FCFs
[?2004l[?2004h>     pv_fcf = [fcf / ((1 + wacc) ** i) for i, fcf in enumerate(project_fcf[:3])]
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate terminal value
[?2004l[?2004h>     terminal_value = project_fcf[3] * (1 + terminal_growth_rate) / (wacc - terminal_growth_rate)
[?2004l[?2004h>     pv_terminal = terminal_value / ((1 + wacc) ** 3)
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate enterprise value
[?2004l[?2004h>     enterprise_value = sum(pv_fcf) + pv_terminal
[?2004l[?2004h>     
[?2004l[?2004h>     # Additional financial data (assumptions)
[?2004l[?2004h>     debt = 15000  # in millions (assumed total debt)
[?2004l[?2004h>     cash = 9151  # cash and cash equivalents as mentioned in task
[?2004l[?2004h>     shares = 1750  # in millions (assumed total diluted shares)
[?2004l[?2004h>     ebitda = 6000  # in millions (assumed EBITDA)
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate financials
[?2004l[?2004h>     # For Net Debt, include notes payable and also current and non-current lease liabilities within debt
[?2004l[?2004h>     # Assume the relevant cash and cash equivalents are equal to $9,151 (as per 10-K)
[?2004l[?2004h>     net_debt = debt - cash  # Subtracting cash
[?2004l[?2004h>     equity_value = enterprise_value - net_debt
[?2004l[?2004h>     equity_per_share = equity_value / shares
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate ratios
[?2004l[?2004h>     ev_revenue = enterprise_value / revenue_2025_valuation
[?2004l[?2004h>     ev_ebitda = enterprise_value / ebitda
[?2004l[?2004h>     
[?2004l[?2004h>     # Market data (as mentioned in task)
[?2004l[?2004h>     market_ev_revenue = 1.90
[?2004l[?2004h>     market_ev_ebitda = 15.84
[?2004l[?2004h>     market_price_per_share = 60.59
[?2004l[?2004h>     
[?2004l[?2004h>     # Comparison
[?2004l[?2004h>     ev_revenue_ratio = ev_revenue / market_ev_revenue
[?2004l[?2004h>     ev_ebitda_ratio = ev_ebitda / market_ev_ebitda
[?2004l[?2004h>     equity_per_share_ratio = equity_per_share / market_price_per_share
[?2004l[?2004h>     
[?2004l[?2004h>     # Value assessment
[?2004l[?2004h>     if (ev_revenue_ratio >= 1.1 or ev_ebitda_ratio >= 1.1 or equity_per_share_ratio >= 1.1):
[?2004l[?2004h>         assessment = "Nike appears undervalued by the market"
[?2004l[?2004h>     elif (ev_revenue_ratio >= 0.9 and ev_ebitda_ratio >= 0.9 and equity_per_share_ratio >= 0.9):
[?2004l[?2004h>         assessment = "Nike appears fairly valued by the market"
[?2004l[?2004h>     elif (ev_revenue_ratio <= 0.9 or ev_ebitda_ratio <= 0.9 or equity_per_share_ratio <= 0.9):
[?2004l[?2004h>         assessment = "Nike appears overvalued by the market"
[?2004l[?2004h>     else:
[?2004l[?2004h>         assessment = "further investigation is needed for your model inputs"
[?2004l[?2004h>     
[?2004l[?2004h>     return {
[?2004l[?2004h>         'enterprise_value': enterprise_value,
[?2004l[?2004h>         'ev_revenue': ev_revenue,
[?2004l[?2004h>         'ev_ebitda': ev_ebitda,
[?2004l[?2004h>         'equity_value': equity_value,
[?2004l[?2004h>         'equity_per_share': equity_per_share,
[?2004l[?2004h>         'assessment': assessment,
[?2004l[?2004h>         'cagr': cagr
[?2004l[?2004h>     }
