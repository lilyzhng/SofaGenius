[403.113673, "o", "    # Additional financial data (assumptions)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.113751, "o", "    debt = 15000  # in millions (assumed total debt)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.113851, "o", "    cash = 9151  # cash and cash equivalents as mentioned in task\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.113958, "o", "    shares = 1750  # in millions (assumed total diluted shares)\r\n\u001b[?2004l\r\u001b[?2004h> "]
