[403.114182, "o", "    # Calculate financials\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.114364, "o", "    # For Net Debt, include notes payable and also current and non-current lease liabilities within debt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.11443, "o", "    # Assume the relevant cash and cash equivalents are equal to $9,151 (as per 10-K)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.114531, "o", "    net_debt = debt - cash  # Subtracting cash\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.114559, "o", "    equity_value = enterprise_value - net_debt\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.114723, "o", "    equity_per_share = equity_value / shares\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     # Calculate ratios\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.114851, "o", "    ev_revenue = enterprise_value / revenue_2025_valuation\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.114974, "o", "    ev_ebitda = enterprise_value / ebitda\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.115109, "o", "    # Market data (as mentioned in task)\r\n\u001b[?2004l\r\u001b[?2004h>     market_ev_revenue = 1.90\r\n\u001b[?2004l\r\u001b[?2004h>     market_ev_ebitda = 15.84\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.115177, "o", "    market_price_per_share = 60.59\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.115279, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     # Comparison\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.115351, "o", "    ev_revenue_ratio = ev_revenue / market_ev_revenue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.115466, "o", "    ev_ebitda_ratio = ev_ebitda / market_ev_ebitda\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.115536, "o", "    equity_per_share_ratio = equity_per_share / market_price_per_share\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.115619, "o", "    # Value assessment\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.115736, "o", "    if (ev_revenue_ratio >= 1.1 or ev_ebitda_ratio >= 1.1 or equity_per_share_ratio >= 1.1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.115851, "o", "        assessment = \"Nike appears undervalued by the market\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.11596, "o", "    elif (ev_revenue_ratio >= 0.9 and ev_ebitda_ratio >= 0.9 and equity_per_share_ratio >= 0.9):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.116035, "o", "        assessment = \"Nike appears fairly valued by the market\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.116166, "o", "    elif (ev_revenue_ratio <= 0.9 or ev_ebitda_ratio <= 0.9 or equity_per_share_ratio <= 0.9):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.116248, "o", "        assessment = \"Nike appears overvalued by the market\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.116374, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h>         assessment = \"further investigation is needed for your model inputs\"\r\n\u001b[?2004l\r"]
[403.11649, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     return {\r\n\u001b[?2004l\r"]
[403.116574, "o", "\u001b[?2004h> "]
[403.1167, "o", "        'enterprise_value': enterprise_value,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.116732, "o", "        'ev_revenue': ev_revenue,\r\n\u001b[?2004l\r\u001b[?2004h>         'ev_ebitda': ev_ebitda,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.116854, "o", "        'equity_value': equity_value,\r\n\u001b[?2004l\r\u001b[?2004h>         'equity_per_share': equity_per_share,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.116884, "o", "        'assessment': assessment,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.117042, "o", "        'cagr': cagr\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Main execution\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.117145, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.117228, "o", "        results = calculate_dcf_simulation()\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.117347, "o", "        # Round all values appropriately\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.117562, "o", "        results['enterprise_value'] = round(results['enterprise_value'] / 1000000)  # Round to millions\r\n\u001b[?2004l\r\u001b[?2004h>         results['ev_revenue'] = round(results['ev_revenue'], 2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.117722, "o", "        results['ev_ebitda'] = round(results['ev_ebitda'], 2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.117872, "o", "        results['equity_value'] = round(results['equity_value'] / 1000000)  # Round to millions\r\n\u001b[?2004l\r\u001b[?2004h>         results['equity_per_share'] = round(results['equity_per_share'], 2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[403.117941, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.118, "o", "        # Write results to output file\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.118086, "o", "        with open('/app/output/answer.txt', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.118262, "o", "            f.write(\"Nike Inc. Financial Analysis (Simulation)\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.118395, "o", "            f.write(\"===============================\\n\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.118424, "o", "            f.write(f\"Enterprise Value: ${results['enterprise_value']} million\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.118532, "o", "            f.write(f\"EV/Revenue Ratio: {results['ev_revenue']}x\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.118611, "o", "            f.write(f\"EV/EBITDA Ratio: {results['ev_ebitda']}x\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.118698, "o", "            f.write(f\"Equity Value: ${results['equity_value']} million\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.118783, "o", "            f.write(f\"Equity Value per Share: ${results['equity_per_share']}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.118911, "o", "            f.write(f\"CAGR (2023-2025): {results['cagr']:.4f} ({results['cagr']*100:.2f}%)\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.119015, "o", "            f.write(f\"Valuation Assessment: {results['assessment']}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.119153, "o", "            f.write(\"\\nNote: This is a simulation since actual data could not be extracted from the PDF\\n\")\r\n\u001b[?2004l\r"]
[403.119224, "o", "\u001b[?2004h>             \r\n\u001b[?2004l\r\u001b[?2004h"]
[403.119297, "o", "> "]
[403.119363, "o", "        print(\"Analysis complete. Results written to /app/output/answer.txt\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.119441, "o", "        print(results)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.119473, "o", "    except Exception as e:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.119587, "o", "        print(f\"Error during analysis: {e}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.119659, "o", "        import traceback\r\n\u001b[?2004l\r\u001b[?2004h>         traceback.print_exc()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[403.119766, "o", "EOF2\r\n\u001b[?2004l\r"]
[403.120803, "o", "\u001b[?2004hroot@a2f87af7d230:/app# "]
