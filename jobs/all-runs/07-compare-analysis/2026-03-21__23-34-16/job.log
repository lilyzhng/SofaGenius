for r in project_revenue]\n    \n    project_fcf = [\n        nopat - capex - nwc + da \n        for nopat, da, capex, nwc in zip(project_nopat, project_d_a, project_capex, project_nwc)\n    ]\n    \n    # Calculate present value of FCFs\n    pv_fcf = [fcf / ((1 + wacc) ** i) for i, fcf in enumerate(project_fcf[:3])]\n    \n    # Calculate terminal value\n    terminal_value = project_fcf[3] * (1 + terminal_growth_rate) / (wacc - terminal_growth_rate)\n    pv_terminal = terminal_value / ((1 + wacc) ** 3)\n    \n    # Calculate enterprise value\n    enterprise_value = sum(pv_fcf) + pv_terminal\n    \n    # Additional financial data (assumptions)\n    debt = 15000  # in millions (assumed total debt)\n    cash = 9151  # cash and cash equivalents as mentioned in task\n    shares = 1750  # in millions (assumed total diluted shares)\n    ebitda = 6000  # in millions (assumed EBITDA)\n    \n    # Calculate financials\n    # For Net Debt, include notes payable and also current and non-current lease liabilities within debt\n    # Assume the relevant cash and cash equivalents are equal to $9,151 (as per 10-K)\n    net_debt = debt - cash  # Subtracting cash\n    equity_value = enterprise_value - net_debt\n    equity_per_share = equity_value / shares\n    \n    # Calculate ratios\n    ev_revenue = enterprise_value / revenue_2025_valuation\n    ev_ebitda = enterprise_value / ebitda\n    \n    # Market data (as mentioned in task)\n    market_ev_revenue = 1.90\n    market_ev_ebitda = 15.84\n    market_price_per_share = 60.59\n    \n    # Comparison\n    ev_revenue_ratio = ev_revenue / market_ev_revenue\n    ev_ebitda_ratio = ev_ebitda / market_ev_ebitda\n    equity_per_share_ratio = equity_per_share / market_price_per_share\n    \n    # Value assessment\n    if (ev_revenue_ratio >= 1.1 or ev_ebitda_ratio >= 1.1 or equity_per_share_ratio >= 1.1):\n        assessment = "Nike appears undervalued by the market"\n    elif (ev_revenue_ratio >= 0.9 and ev_ebitda_ratio >= 0.9 and equity_per_share_ratio >= 0.9):\n        assessment = "Nike appears fairly valued by the market"\n    elif (ev_revenue_ratio <= 0.9 or ev_ebitda_ratio <= 0.9 or equity_per_share_ratio <= 0.9):\n        assessment = "Nike appears overvalued by the market"\n    else:\n        assessment = "further investigation is needed for your model inputs"\n    \n    return {\n        \'enterprise_value\': enterprise_value,\n        \'ev_revenue\': ev_revenue,\n        \'ev_ebitda\': ev_ebitda,\n        \'equity_value\': equity_value,\n        \'equity_per_share\': equity_per_share,\n        \'assessment\': assessment,\n        \'cagr\': cagr\n    }\n\n# Main execution\nif __name__ == \'__main__\':\n    try:\n        results = calculate_dcf_simulation()\n        \n        # Round all values appropriately\n        results[\'enterprise_value\'] = round(results[\'enterprise_value\'] / 1000000)  # Round to millions\n        results[\'ev_revenue\'] = round(results[\'ev_revenue\'], 2)\n        results[\'ev_ebitda\'] = round(results[\'ev_ebitda\'], 2)\n        results[\'equity_value\'] = round(results[\'equity_value\'] / 1000000)  # Round to millions\n        results[\'equity_per_share\'] = round(results[\'equity_per_share\'], 2)\n        \n        # Write results to output file\n        with open(\'/app/output/answer.txt\', \'w\') as f:\n            f.write("Nike Inc. Financial Analysis (Simulation)\\n")\n            f.write("===============================\\n\\n")\n            f.write(f"Enterprise Value: ${results[\'enterprise_value\']} million\\n")\n            f.write(f"EV/Revenue Ratio: {results[\'ev_revenue\']}x\\n")\n            f.write(f"EV/EBITDA Ratio: {results[\'ev_ebitda\']}x\\n")\n            f.write(f"Equity Value: ${results[\'equity_value\']} million\\n")\n            f.write(f"Equity Value per Share: ${results[\'equity_per_share\']}\\n")\n            f.write(f"CAGR (2023-2025): {results[\'cagr\']:.4f} ({results[\'cagr\']*100:.2f}%)\\n")\n            f.write(f"Valuation Assessment: