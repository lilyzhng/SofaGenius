[53.204912, "o", "    f.write(\"EMPLOYEE GRADE ANALYSIS REPORT\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.205023, "o", "    f.write(\"=\" * 50 + \"\\n\\n\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
