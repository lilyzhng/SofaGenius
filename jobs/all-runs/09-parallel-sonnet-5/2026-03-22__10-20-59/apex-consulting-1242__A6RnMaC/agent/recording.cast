[60.537895, "o", "  M3: 99 employees\r\n"]
[60.538125, "o", "  M4: 4 employees\r\n"]
[60.538373, "o", "  M5: 5 employees\r\n"]
[60.540925, "o", "\r\n=== CALCULATIONS BY GRADE ===\r\n"]
[60.541417, "o", "\r\nGrade M1:\r\n  Employees: 272\r\n  Average Lifetime Revenue: $17,381,898.29\r\n  Average Lifetime Pay: $6,374,085.68\r\n  Average Annual Pay: $780,461.00\r\n  Ratio (Revenue/Pay): 2.73\r\n"]
[60.541749, "o", "\r\nGrade M2:\r\n  Employees: 101\r\n  Average Lifetime Revenue: $38,506,630.96\r\n  Average Lifetime Pay: $11,833,674.95\r\n  Average Annual Pay: $1,572,508.23\r\n  Ratio (Revenue/Pay): 3.25\r\n"]
[60.5421, "o", "\r\nGrade M3:\r\n  Employees: 99\r\n  Average Lifetime Revenue: $55,288,168.26\r\n  Average Lifetime Pay: $18,048,691.41\r\n  Average Annual Pay: $2,380,928.51\r\n  Ratio (Revenue/Pay): 3.06\r\n"]
[60.542394, "o", "\r\nGrade M4:\r\n  Employees: 4\r\n  Average Lifetime Revenue: $72,124,499.00\r\n  Average Lifetime Pay: $25,426,912.80\r\n  Average Annual Pay: $3,935,879.00\r\n  Ratio (Revenue/Pay): 2.84\r\n"]
[60.542672, "o", "\r\nGrade M5:\r\n  Employees: 5\r\n  Average Lifetime Revenue: $103,850,108.40\r\n  Average Lifetime Pay: $59,770,771.50\r\n  Average Annual Pay: $6,397,731.60\r\n  Ratio (Revenue/Pay): 1.74\r\n"]
[60.542862, "o", "\r\n=== WEIGHTED AVERAGE RATIOS ===\r\n"]
[60.542972, "o", "Grade M1: 2.73 (weight: 272 employees)\r\n"]
[60.543067, "o", "Grade M2: 3.25 (weight: 101 employees)\r\n"]
[60.543113, "o", "Grade M3: 3.06 (weight: 99 employees)\r\nGrade M4: 2.84 (weight: 4 employees)\r\n"]
[60.54319, "o", "Grade M5: 1.74 (weight: 5 employees)\r\n"]
[60.544696, "o", "\r\n=== TOP 2 GRADES WITH BEST RATIOS ===\r\n"]
[60.544795, "o", "1. Grade M2: 3.25\r\n"]
[60.544857, "o", "2. Grade M3: 3.06\r\n\r\n=== COST ANALYSIS FOR 20% EMPLOYEE INCREASE ===\r\n"]
[60.544931, "o", "\r\nGrade M2:\r\n  Current employees: 101\r\n  Additional employees (20%): 20\r\n  Average annual pay: $1,572,508\r\n  Additional annual cost: $31,450,165\r\n"]
[60.545009, "o", "\r\nGrade M3:\r\n  Current employees: 99\r\n  Additional employees (20%): 20\r\n  Average annual pay: $2,380,929\r\n  Additional annual cost: $47,618,570\r\n\r\nTotal additional annual cost: $79,068,735\r\n"]
