[53.202874, "o", "for i, (_, row) in enumerate(top_grades.iterrows(), 1):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.202979, "o", "    print(f\"{i}. Grade {row['Grade']}: {row['Ratio']:.2f}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[53.203057, "o", "\u001b[?2004h> # Calculate additional cost for 20% increase\r\n\u001b[?2004l\r"]
[53.203128, "o", "\u001b[?2004h> "]
[53.203241, "o", "print(\"\\n=== COST ANALYSIS FOR 20% EMPLOYEE INCREASE ===\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.203264, "o", "total_additional_cost = 0\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.203329, "o", "for _, row in top_grades.iterrows():\r\n\u001b[?2004l\r"]
[53.20347, "o", "\u001b[?2004h>     grade = row['Grade']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.203498, "o", "    current_employees = row['Employee_Count']\r\n\u001b[?2004l\r\u001b[?2004h>     avg_annual_pay = row['Avg_Annual_Pay']"]
[53.203602, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.203718, "o", "    additional_employees = round(current_employees * 0.20)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.203752, "o", "    additional_annual_cost = additional_employees * avg_annual_pay\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.203885, "o", "    total_additional_cost += additional_annual_cost\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.203975, "o", "    print(f\"\\nGrade {grade}:\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.204003, "o", "> "]
[53.204121, "o", "    print(f\"  Current employees: {current_employees}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.2042, "o", "    print(f\"  Additional employees (20%): {additional_employees}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.204296, "o", "    print(f\"  Average annual pay: ${avg_annual_pay:,.0f}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.204415, "o", "    print(f\"  Additional annual cost: ${additional_annual_cost:,.0f}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[53.20444, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[53.20458, "o", "print(f\"\\nTotal additional annual cost: ${total_additional_cost:,.0f}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[53.20465, "o", "\u001b[?2004h> "]
