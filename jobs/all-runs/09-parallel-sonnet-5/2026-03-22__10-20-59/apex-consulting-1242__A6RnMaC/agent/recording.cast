[53.205125, "o", "\u001b[?2004h> "]
[53.205252, "o", "    f.write(f\"Total employees analyzed: {len(df)}\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.205341, "o", "    f.write(\"Grade distribution:\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.205433, "o", "    for grade in sorted(df['Grade'].unique()):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.205519, "o", "        count = len(df[df['Grade'] == grade])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.205552, "o", "        f.write(f\"  {grade}: {count} employees\\n\")"]
[53.205673, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
