Sending keys: ['cat > /app/analysis.py << \'EOF\'\nimport pandas as pd\nimport numpy as np\nfrom datetime import datetime\n\n# Load the data\ndf = pd.read_csv(\'/app/data/Data.csv\')\n\n# Clean column names\ndf.columns = df.columns.str.strip()\n\nprint("=== EMPLOYEE GRADE ANALYSIS ===")\nprint(f"Total employees: {len(df)}")\nprint(f"Grade distribution:")\nfor grade in sorted(df[\'Grade\'].unique()):\n    count = len(df[df[\'Grade\'] == grade])\n    print(f"  {grade}: {count} employees")\n\n# Convert Date of Joining to datetime\ndf[\'Date of Joining\'] = pd.to_datetime(df[\'Date of Joining\'])\n\n# Define end date (10/25/2025)\nend_date = datetime(2025, 10, 25)\n\n# Calculate lifetime in years for each employee\ndf[\'Lifetime_Years\'] = (end_date - df[\'Date of Joining\']).dt.days / 365.25\n\n# Calculate lifetime revenue and lifetime pay for each employee\ndf[\'Lifetime_Pay\'] = df[\'Total Pay\'] * df[\'Lifetime_Years\']\n\nprint("\\n=== CALCULATIONS BY GRADE ===")\n\nresults = []\nfor grade in sorted(df[\'Grade\'].unique()):\n    grade_data = df[df[\'Grade\'] == grade]\n    \n    # Calculate averages\n    avg_lifetime_revenue = grade_data[\'Lifetime Revenue\'].mean()\n    avg_lifetime_pay = grade_data[\'Lifetime_Pay\'].mean()\n    avg_annual_pay = grade_data[\'Total Pay\'].mean()\n    \n    # Calculate ratio\n    ratio = avg_lifetime_revenue / avg_lifetime_pay\n    \n    # Count employees\n    employee_count = len(grade_data)\n    \n    results.append({\n        \'Grade\': grade,\n        \'Employee_Count\': employee_count,\n        \'Avg_Lifetime_Revenue\': avg_lifetime_revenue,\n        \'Avg_Lifetime_Pay\': avg_lifetime_pay,\n        \'Avg_Annual_Pay\': avg_annual_pay,\n        \'Ratio\': ratio\n    })\n    \n    print(f"\\nGrade {grade}:")\n    print(f"  Employees: {employee_count}")\n    print(f"  Average Lifetime Revenue: ${avg_lifetime_revenue:,.2f}")\n    print(f"  Average Lifetime Pay: ${avg_lifetime_pay:,.2f}")\n    print(f"  Average Annual Pay: ${avg_annual_pay:,.2f}")\n    print(f"  Ratio (Revenue/Pay): {ratio:.2f}")\n\n# Convert to DataFrame for easier manipulation\nresults_df = pd.DataFrame(results)\n\n# Calculate weighted average ratio for each grade\nprint("\\n=== WEIGHTED AVERAGE RATIOS ===")\nfor _, row in results_df.iterrows():\n    grade = row[\'Grade\']\n    ratio = row[\'Ratio\']\n    employee_count = row[\'Employee_Count\']\n    print(f"Grade {grade}: {ratio:.2f} (weight: {employee_count} employees)")\n\n# Sort by ratio to find top 2 grades\ntop_grades = results_df.nlargest(2, \'Ratio\')\n\nprint("\\n=== TOP 2 GRADES WITH BEST RATIOS ===")\nfor i, (_, row) in enumerate(top_grades.iterrows(), 1):\n    print(f"{i}. Grade {row[\'Grade\']}: {row[\'Ratio\']:.2f}")\n\n# Calculate additional cost for 20% increase\nprint("\\n=== COST ANALYSIS FOR 20% EMPLOYEE INCREASE ===")\ntotal_additional_cost = 0\n\nfor _, row in top_grades.iterrows():\n    grade = row[\'Grade\']\n    current_employees = row[\'Employee_Count\']\n    avg_annual_pay = row[\'Avg_Annual_Pay\']\n    \n    additional_employees = round(current_employees * 0.20)\n    additional_annual_cost = additional_employees * avg_annual_pay\n    total_additional_cost += additional_annual_cost\n    \n    print(f"\\nGrade {grade}:")\n    print(f"  Current employees: {current_employees}")\n    print(f"  Additional employees (20%): {additional_employees}")\n    print(f"  Average annual pay: ${avg_annual_pay:,.0f}")\n    print(f"  Additional annual cost: ${additional_annual_cost:,.0f}")\n\nprint(f"\\nTotal additional annual cost: ${total_additional_cost:,.0f}")\n\n# Write detailed results to output file\nwith open(\'/app/output/answer.txt\', \'w\') as f:\n    f.write("EMPLOYEE GRADE ANALYSIS REPORT\\n")\n    f.write("=" * 50 + "\\n\\n")\n    \n    f.write("DATASET OVERVIEW:\\n")\n    f.write(f"Total employees analyzed: {len(df)}\\n")\n    f.write("Grade distribution:\\n")\n    for grade in sorted(df[\'Grade\'].unique()):\n        count = len(df[df[\'Grade\'] == grade])\n        f.write(f"  {grade}: {count} employees\\n")\n    \n    f.write("\\nMETHODOLOGY:\\n")\n    f.write("- Employee lifetime calculated from joining date to 10/25/2025\\n")\n    f.write("- Lifetime pay = Total annual pay × Lifetime in years\\n")\n    f.write("- Ratio = Average lifetime revenue ÷ Average lifetime pay\\n")\n    f.write("- All calculations performed without rounding interim values\\n")\n    \n    f.write("\\nDETAILED CALCULATIONS BY GRADE:\\n")\n    for _, row in results_df.iterrows():\n        f.write(f"\\nGrade {row[\'Grade\']}:\\n")\n        f.write(f"  Number of employees: {row[\'Employee_Count\']}\\n")\n        f.write(f"  Average lifetime revenue: ${row[\'Avg_Lifetime_Revenue\']:,.2f}\\n")\n        f.write(f"  Average lifetime pay: ${row[\'Avg_Lifetime_Pay\']:,.2f}\\n")\n        f.write(f"  Average annual pay: ${row[\'Avg_Annual_Pay\']:,.0f}\\n")\n        f.write(f"  Revenue-to-pay ratio: {row[\'Ratio\']:.2f}\\n")\n    \n    f.write("\\nTOP TWO GRADES WITH BEST RATIOS:\\n")\n    for i, (_, row) in enumerate(top_grades.iterrows(), 1):\n        f.write(f"{i}. Grade {row[\'Grade\']}: {row[\'Ratio\']:.2f}\\n")\n    \n    f.write("\\nCOST IMPACT OF 20% EMPLOYEE INCREASE:\\n")\n    total_cost = 0\n    for _, row in top_grades.iterrows():\n        grade = row[\'Grade\']\n        current_employees = row[\'Employee_Count\']\n        avg_annual_pay = row[\'Avg_Annual_Pay\']\n        additional_employees = round(current_employees * 0.20)\n        additional_cost = additional_employees * avg_annual_pay\n        total_cost += additional_cost\n        \n        f.write(f"\\nGrade {grade}:\\n")\n        f.write(f"  Current employees: {current_employees}\\n")\n        f.write(f"  Additional employees (20%): {additional_employees}\\n")\n        f.write(f"  Average annual pay per employee: ${avg_annual_pay:,.0f}\\n")\n        f.write(f"  Additional annual cost: ${additional_cost:,.0f}\\n")\n    \n    f.write(f"\\nTotal additional annual cost: ${total_cost:,.0f}\\n")\n    \n    f.write("\\nRECOMMENDAIONS:\\n")\n    f.write(f"Based on the analysis, I recommend focusing expansion on grades ")\n    f.write(f"{top_grades.iloc[0][\'Grade\']} and {top_grades.iloc[1][\'Grade\']} as they provide ")\n    f.write(f"the highest revenue-to-pay ratios of {top_grades.iloc[0][\'Ratio\']:.2f} ")\n    f.write(f"and {top_grades.iloc[1][\'Ratio\']:.2f} respectively. ")\n    f.write(f"These grades generate the most revenue per dollar of compensation, ")\n    f.write(f"making them the most cost-effective for expansion. The 20% increase ")\n    f.write(f"would require an additional annual investment of ${total_cost:,.0f}.")\n\nprint("\\n=== ANALYSIS COMPLETE ===")\nprint("Detailed results written to /app/output/answer.txt")\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
