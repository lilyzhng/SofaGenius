[?2004l[?2004h> 
[?2004l[?2004h> # Waterfall calculation
[?2004l[?2004h> years_held = 4  # FY24 to FY28
[?2004l[?2004h> preferred_return_total = entry_equity * ((1 + preferred_return) ** years_held - 1)
[?2004l[?2004h> total_return = exit_equity_value
[?2004l[?2004h> profit = total_return - entry_equity
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Years Held: {years_held}")
[?2004l[?2004h> print(f"Preferred Return Required: ${preferred_return_total:,.0f}k")
[?2004l[?2004h> print(f"Total Profit: ${profit:,.0f}k")
[?2004l[?2004h> 
[?2004l[?2004h> if profit > preferred_return_total:
[?2004l[?2004h>     excess_profit = profit - preferred_return_total
[?2004l[?2004h>     management_options = excess_profit * management_option_pool
[?2004l[?2004h>     carry_profit = excess_profit - management_options
[?2004l[?2004h>     gp_carry = carry_profit * carry_rate
[?2004l[?2004h>     lp_share = entry_equity + preferred_return_total + (carry_profit - gp_carry)
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"Excess Profit: ${excess_profit:,.0f}k")
[?2004l[?2004h>     print(f"Management Options (5%): ${management_options:,.0f}k")
[?2004l[?2004h>     print(f"GP Carry (20%): ${gp_carry:,.0f}k")
[?2004l[?2004h>     print(f"LP Total Return: ${lp_share:,.0f}k")
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate IRR and MOIC for LPs
[?2004l[?2004h>     lp_moic = lp_share / entry_equity
[?2004l[?2004h>     lp_irr = (lp_moic ** (1/years_held)) - 1
[?2004l[?2004h>     
[?2004l[?2004h>     print(f"LP MOIC: {lp_moic:.2f}x")
[?2004l[?2004h>     print(f"LP IRR: {lp_irr:.2%}")
[?2004l[?2004h> else:
[?2004l[?2004h>     print("Preferred return not achieved")
