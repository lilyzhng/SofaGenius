[54.142129, "i", "cat > get_ebitda.py << 'EOF'\nimport pandas as pd\nimport numpy as np\n\n# Read the Excel file\nfile_path = '/app/data/ConSup Inc Financial Model_PROMPT.xlsx'\n\n# Read financial statements\nfinancials_df = pd.read_excel(file_path, sheet_name='Financial Statements', header=None)\n\nprint(\"Looking for EBITDA data...\")\nfor i in range(len(financials_df)):\n    row_data = list(financials_df.iloc[i])\n    row_str = ' '.join([str(cell) for cell in row_data if pd.notna(cell)])\n    if 'EBITDA' in row_str.upper() and ('$' in row_str or any(isinstance(cell, (int, float)) and cell > 1000 for cell in row_data)):\n        print(f\"Row {i}: {row_data}\")\n\nprint(\"\\nLooking for Payroll data...\")\nfor i in range(len(financials_df)):\n    row_data = list(financials_df.iloc[i])\n    row_str = ' '.join([str(cell) for cell in row_data if pd.notna(cell)])\n    if 'PAYROLL' in row_str.upper() or 'CORE BUSINESS' in row_str.upper():\n        print(f\"Row {i}: {row_data}\")\n\nprint(\"\\nExtracting key transaction data:\")\ntrans_df = pd.read_excel(file_path, sheet_name='Transaction Structure', header=None)\n\n# Extract key values\nfy24_ebitda = 8318.254226224823\npurchase_multiple = 8\nrollover_equity_pct = 0.15\nrollover_equity = 6763.012109848733\nsponsor_equity = 38323.73528914282\ntotal_equity = rollover_equity + sponsor_equity\n\nprint(f\"FY24 EBITDA: ${fy24_ebitda:,.0f}k\")\nprint(f\"Purchase Multiple: {purchase_multiple}x\")\nprint(f\"Rollover Equity: ${rollover_equity:,.0f}k\")\nprint(f\"Sponsor Equity: ${sponsor_equity:,.0f}k\")\nprint(f\"Total Equity: ${total_equity:,.0f}k\")\nEOF\n"]
