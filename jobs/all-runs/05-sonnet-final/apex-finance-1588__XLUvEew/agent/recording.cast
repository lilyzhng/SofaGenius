[90.16467, "o", "exit_ebitda = ebitda_original['FY28']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.164765, "o", "exit_enterprise_value = exit_ebitda * exit_multiple\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.16485, "o", "print(f\"Exit EBITDA (FY28): ${exit_ebitda:,.0f}k\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.16491, "o", "print(f\"Exit Multiple: {exit_multiple}x\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.164976, "o", "print(f\"Exit Enterprise Value: ${exit_enterprise_value:,.0f}k\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[90.165089, "o", "\u001b[?2004h> # Assume debt paydown - simplified assumption\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.165174, "o", "# Will need to model debt schedule properly\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.165371, "o", "remaining_debt = 20000  # Placeholder"]
[90.165403, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> exit_equity_value = exit_enterprise_value - remaining_debt\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.165537, "o", "print(f\"Exit Equity Value: ${exit_equity_value:,.0f}k\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.165568, "o", "# Waterfall calculation\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.16578, "o", "years_held = 4  # FY24 to FY28\r\n\u001b[?2004l\r\u001b[?2004h> preferred_return_total = entry_equity * ((1 + preferred_return) ** years_held - 1)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.165946, "o", "total_return = exit_equity_value\r\n\u001b[?2004l\r\u001b[?2004h> profit = total_return - entry_equity\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Years Held: {years_held}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.1661, "o", "print(f\"Preferred Return Required: ${preferred_return_total:,.0f}k\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.166176, "o", "print(f\"Total Profit: ${profit:,.0f}k\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.166206, "o", "if profit > preferred_return_total:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.166334, "o", "    excess_profit = profit - preferred_return_total"]
[90.166444, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.166536, "o", "    management_options = excess_profit * management_option_pool\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.16667, "o", "    carry_profit = excess_profit - management_options\r\n\u001b[?2004l\r\u001b[?2004h>     gp_carry = carry_profit * carry_rate\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.166783, "o", "    lp_share = entry_equity + preferred_return_total + (carry_profit - gp_carry)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.166862, "o", "    \r\n\u001b[?2004l\r"]
[90.16689, "o", "\u001b[?2004h> "]
[90.166956, "o", "    print(f\"Excess Profit: ${excess_profit:,.0f}k\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.167037, "o", "    print(f\"Management Options (5%): ${management_options:,.0f}k\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.16712, "o", "    print(f\"GP Carry (20%): ${gp_carry:,.0f}k\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.167214, "o", "    print(f\"LP Total Return: ${lp_share:,.0f}k\")\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.167292, "o", "    # Calculate IRR and MOIC for LPs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.167525, "o", "    lp_moic = lp_share / entry_equity\r\n\u001b[?2004l\r\u001b[?2004h>     lp_irr = (lp_moic ** (1/years_held)) - 1\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"LP MOIC: {lp_moic:.2f}x\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.167622, "o", "    print(f\"LP IRR: {lp_irr:.2%}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.167703, "o", "else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.167745, "o", "    print(\"Preferred return not achieved\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.167779, "o", "print()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.167882, "o", "print(\"=== SCENARIO 2: EXIT FY29 AT 16.0x EV/EBITDA ===\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.167962, "o", "exit_year = 'FY29'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.167991, "o", "exit_multiple = 16.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.168203, "o", "exit_ebitda = ebitda_original['FY29']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.168327, "o", "exit_enterprise_value = exit_ebitda * exit_multiple\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.168432, "o", "print(f\"Exit EBITDA (FY29): ${exit_ebitda:,.0f}k\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.16852, "o", "print(f\"Exit Multiple: {exit_multiple}x\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.168673, "o", "print(f\"Exit Enterprise Value: ${exit_enterprise_value:,.0f}k\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.168708, "o", "# Similar calculation for FY29\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.168853, "o", "remaining_debt = 15000  # Placeholder - less debt after 5 years\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.168982, "o", "exit_equity_value = exit_enterprise_value - remaining_debt\r\n\u001b[?2004l\r\u001b[?2004h> years_held = 5\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.169059, "o", "print(f\"Exit Equity Value: ${exit_equity_value:,.0f}k\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.169192, "o", "print(f\"Years Held: {years_held}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.169263, "o", "preferred_return_total = entry_equity * ((1 + preferred_return) ** years_held - 1)\r\n\u001b[?2004l\r\u001b[?2004h> profit = exit_equity_value - entry_equity"]
[90.169293, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[90.169361, "o", "\u001b[?2004h> "]
[90.169545, "o", "print(f\"Preferred Return Required: ${preferred_return_total:,.0f}k\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.169667, "o", "print(f\"Total Profit: ${profit:,.0f}k\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.169696, "o", "if profit > preferred_return_total:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.169811, "o", "    excess_profit = profit - preferred_return_total\r\n\u001b[?2004l\r\u001b[?2004h>     management_options = excess_profit * management_option_pool\r\n\u001b[?2004l\r"]
[90.169837, "o", "\u001b[?2004h> "]
[90.169929, "o", "    carry_profit = excess_profit - management_options\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.170033, "o", "    gp_carry = carry_profit * carry_rate\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.170219, "o", "    lp_share = entry_equity + preferred_return_total + (carry_profit - gp_carry)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.17025, "o", "    print(f\"Excess Profit: ${excess_profit:,.0f}k\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.170363, "o", "    print(f\"Management Options (5%): ${management_options:,.0f}k\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.170459, "o", "    print(f\"GP Carry (20%): ${gp_carry:,.0f}k\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.170544, "o", "    print(f\"LP Total Return: ${lp_share:,.0f}k\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.170581, "o", "    \r\n\u001b[?2004l\r"]
[90.170661, "o", "\u001b[?2004h>     # Calculate IRR and MOIC for LPs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.170764, "o", "    lp_moic = lp_share / entry_equity\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.17083, "o", "    lp_irr = (lp_moic ** (1/years_held)) - 1\r\n\u001b[?2004l\r\u001b[?2004h"]
[90.17086, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[90.170959, "o", ">     print(f\"LP MOIC: {lp_moic:.2f}x\")\r\n\u001b[?2004l\r"]
[90.170981, "o", "\u001b[?2004h> "]
[90.171048, "o", "    print(f\"LP IRR: {lp_irr:.2%}\")\r\n\u001b[?2004l\r\u001b[?2004h> else:\r\n\u001b[?2004l\r"]
[90.171097, "o", "\u001b[?2004h> "]
[90.171208, "o", "    print(\"Preferred return not achieved\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
