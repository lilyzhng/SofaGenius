[90.158893, "i", "cat > lbo_model.py << 'EOF'\nimport pandas as pd\nimport numpy as np\n\n# Key transaction parameters\nfy24_ebitda = 8318.254226224824\npurchase_multiple = 8\nrollover_equity = 6763.012109848733\nsponsor_equity = 38323.73528914282\ntotal_equity = rollover_equity + sponsor_equity\nentry_equity = total_equity\n\n# Original EBITDA projections (in $000s)\nebitda_original = {\n    'FY24': 8318.254226224824,\n    'FY25': 8906.637713389122,\n    'FY26': 9303.029304349491,\n    'FY27': 10140.561173162932,\n    'FY28': 10838.830677772166,\n    'FY29': 11698.13446649975\n}\n\n# Original payroll projections (in $000s)\npayroll_original = {\n    'FY24': 3401.06,\n    'FY25': 3721.113,\n    'FY26': 4064.66865,\n    'FY27': 4783.652082500001,\n    'FY28': 5065.159686625,\n    'FY29': 5364.975170956251\n}\n\nprint(\"=== LBO MODEL ANALYSIS ===\")\nprint(f\"Entry Equity: ${entry_equity:,.0f}k\")\nprint(f\"FY24 EBITDA: ${fy24_ebitda:,.0f}k\")\nprint(f\"Purchase Multiple: {purchase_multiple}x\")\nprint()\n\nprint(\"Original EBITDA Projections:\")\nfor year, ebitda in ebitda_original.items():\n    print(f\"{year}: ${ebitda:,.0f}k\")\nprint()\n\nprint(\"Original Payroll Projections:\")\nfor year, payroll in payroll_original.items():\n    print(f\"{year}: ${payroll:,.0f}k\")\nprint()\n\n# Calculate adjusted payroll (Core Business grows at 7% instead of 5%)\n# Need to extract core business payroll component and adjust\nprint(\"Adjusting Core Business payroll growth from 5% to 7%...\")\nprint(\"(Continuing with current projections for now - will refine)\")\nprint()\n\n# Waterfall parameters\npreferred_return = 0.08\ncarry_rate = 0.20\nmanagement_option_pool = 0.05\n\nprint(\"=== SCENARIO 1: EXIT FY28 AT 15.0x EV/EBITDA ===\")\nexit_year = 'FY28'\nexit_multiple = 15.0\nexit_ebitda = ebitda_original['FY28']\nexit_enterprise_value = exit_ebitda * exit_multiple\n\nprint(f\"Exit EBITDA (FY28): ${exit_ebitda:,.0f}k\")\nprint(f\"Exit Multiple: {exit_multiple}x\")\nprint(f\"Exit Enterprise Value: ${exit_enterprise_value:,.0f}k\")\n\n# Assume debt paydown - simplified assumption\n# Will need to model debt schedule properly\nremaining_debt = 20000  # Placeholder\nexit_equity_value = exit_enterprise_value - remaining_debt\n\nprint(f\"Exit Equity Value: ${exit_equity_value:,.0f}k\")\n\n# Waterfall calculation\nyears_held = 4  # FY24 to FY28\npreferred_return_total = entry_equity * ((1 + preferred_return) ** years_held - 1)\ntotal_return = exit_equity_value\nprofit = total_return - entry_equity\n\nprint(f\"Years Held: {years_held}\")\nprint(f\"Preferred Return Required: ${preferred_return_total:,.0f}k\")\nprint(f\"Total Profit: ${profit:,.0f}k\")\n\nif profit > preferred_return_total:\n    excess_profit = profit - preferred_return_total\n    management_options = excess_profit * management_option_pool\n    carry_profit = excess_profit - management_options\n    gp_carry = carry_profit * carry_rate\n    lp_share = entry_equity + preferred_return_total + (carry_profit - gp_carry)\n    \n    print(f\"Excess Profit: ${excess_profit:,.0f}k\")\n    print(f\"Management Options (5%): ${management_options:,.0f}k\")\n    print(f\"GP Carry (20%): ${gp_carry:,.0f}k\")\n    print(f\"LP Total Return: ${lp_share:,.0f}k\")\n    \n    # Calculate IRR and MOIC for LPs\n    lp_moic = lp_share / entry_equity\n    lp_irr = (lp_moic ** (1/years_held)) - 1\n    \n    print(f\"LP MOIC: {lp_moic:.2f}x\")\n    print(f\"LP IRR: {lp_irr:.2%}\")\nelse:\n    print(\"Preferred return not achieved\")\n\nprint()\nprint(\"=== SCENARIO 2: EXIT FY29 AT 16.0x EV/EBITDA ===\")\nexit_year = 'FY29'\nexit_multiple = 16.0\nexit_ebitda = ebitda_original['FY29']\nexit_enterprise_value = exit_ebitda * exit_multiple\n\nprint(f\"Exit EBITDA (FY29): ${exit_ebitda:,.0f}k\")\nprint(f\"Exit Multiple: {exit_multiple}x\")\nprint(f\"Exit Enterprise Value: ${exit_enterprise_value:,.0f}k\")\n\n# Similar calculation for FY29\nremaining_debt = 15000  # Placeholder - less debt after 5 years\nexit_equity_value = exit_enterprise_value - remaining_debt\nyears_held = 5\n\nprint(f\"Exit Equity Value: ${exit_equity_value:,.0f}k\")\nprint(f\"Years Held: {years_held}\")\n\npreferred_return_total = entry_equity * ((1 + preferred_return) ** years_held - 1)\nprofit = exit_equity_value - entry_equity\n\nprint(f\"Pref"]
[90.15902, "i", "erred Return Required: ${preferred_return_total:,.0f}k\")\nprint(f\"Total Profit: ${profit:,.0f}k\")\n\nif profit > preferred_return_total:\n    excess_profit = profit - preferred_return_total\n    management_options = excess_profit * management_option_pool\n    carry_profit = excess_profit - management_options\n    gp_carry = carry_profit * carry_rate\n    lp_share = entry_equity + preferred_return_total + (carry_profit - gp_carry)\n    \n    print(f\"Excess Profit: ${excess_profit:,.0f}k\")\n    print(f\"Management Options (5%): ${management_options:,.0f}k\")\n    print(f\"GP Carry (20%): ${gp_carry:,.0f}k\")\n    print(f\"LP Total Return: ${lp_share:,.0f}k\")\n    \n    # Calculate IRR and MOIC for LPs\n    lp_moic = lp_share / entry_equity\n    lp_irr = (lp_moic ** (1/years_held)) - 1\n    \n    print(f\"LP MOIC: {lp_moic:.2f}x\")\n    print(f\"LP IRR: {lp_irr:.2%}\")\nelse:\n    print(\"Preferred return not achieved\")\nEOF\n"]
