[90.164507, "o", "print(\"=== SCENARIO 1: EXIT FY28 AT 15.0x EV/EBITDA ===\")\r\n\u001b[?2004l\r\u001b[?2004h> exit_year = 'FY28'\r\n\u001b[?2004l\r\u001b[?2004h> "]
