[33.641816, "i", "cat > extract_data.py << 'EOF'\nimport pandas as pd\nimport numpy as np\n\n# Read the Excel file\nfile_path = '/app/data/ConSup Inc Financial Model_PROMPT.xlsx'\n\n# Read each sheet without headers to see raw structure\nprint(\"=== TRANSACTION STRUCTURE (Raw) ===\")\ntrans_df = pd.read_excel(file_path, sheet_name='Transaction Structure', header=None)\nprint(\"Shape:\", trans_df.shape)\nfor i in range(min(25, len(trans_df))):\n    print(f\"Row {i}: {list(trans_df.iloc[i])}\")\n\nprint(\"\\n=== FINANCIAL STATEMENTS (Raw) ===\")\nfinancials_df = pd.read_excel(file_path, sheet_name='Financial Statements', header=None)\nprint(\"Shape:\", financials_df.shape)\nprint(\"Columns:\", list(financials_df.columns))\n\n# Look for EBITDA and revenue data\nfor i in range(min(30, len(financials_df))):\n    row_data = list(financials_df.iloc[i])\n    if any(str(cell).upper().find('EBITDA') >= 0 for cell in row_data if pd.notna(cell)):\n        print(f\"EBITDA Row {i}: {row_data}\")\n    if any(str(cell).upper().find('REVENUE') >= 0 for cell in row_data if pd.notna(cell)):\n        print(f\"Revenue Row {i}: {row_data}\")\nEOF\n"]
