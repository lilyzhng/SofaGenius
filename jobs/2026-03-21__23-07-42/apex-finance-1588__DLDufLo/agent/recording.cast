[61.195927, "i", "cat > /app/scripts/parse_financial_data.py << 'EOF'\nimport pandas as pd\nfrom openpyxl import load_workbook\n\n# Load the Excel file\ndata_file = \"/app/data/ConSup Inc Financial Model_PROMPT.xlsx\"\n\n# Load workbook to see structure\nwb = load_workbook(data_file)\nprint(\"Sheet names:\")\nfor i, name in enumerate(wb.sheetnames):\n    print(f\"{i}: {name}\")\n\n# Read specific sheets with proper column handling\ntry:\n    # Let's focus on Financial Statements\n    df_financial = pd.read_excel(data_file, sheet_name=\"Financial Statements\", header=3)\n    print(f\"\\nFinancial Statements (first 10 rows):\")\n    print(df_financial.head(10))\n    print(f\"Shape: {df_financial.shape}\")\n    \n    # Read Transaction Structure\n    df_transaction = pd.read_excel(data_file, sheet_name=\"Transaction Structure\", header=3)\n    print(f\"\\nTransaction Structure (first 10 rows):\")\n    print(df_transaction.head(10))\n    print(f\"Shape: {df_transaction.shape}\")\n    \n    # Read Assumptions\n    df_assumptions = pd.read_excel(data_file, sheet_name=\"Assumptions\", header=3)\n    print(f\"\\nAssumptions (first 10 rows):\")\n    print(df_assumptions.head(10))\n    print(f\"Shape: {df_assumptions.shape}\")\n    \nexcept Exception as e:\n    print(f\"Error processing sheets: {e}\")\n    \n# Look for EBITDA related data in the Financial Statements\nif 'Financial Statements' in wb.sheetnames:\n    try:\n        df_financial = pd.read_excel(data_file, sheet_name=\"Financial Statements\", header=3)\n        # Look for EBITDA column\n        ebitda_cols = [col for col in df_financial.columns if 'EBITDA' in str(col) or 'ebitda' in str(col)]\n        print(f\"\\nEBITDA related columns found: {ebitda_cols}\")\n        \n        # Filter for EBITDA data\n        if len(ebitda_cols) > 0:\n            # Print the EBITDA values\n            print(\"\\nEBITDA values:\")\n            for col in ebitda_cols:\n                values = df_financial[col].dropna().tolist()[:10]  # First 10 values\n                print(f\"{col}: {values}\")\n    except Exception as e:\n        print(f\"Error analyzing EBITDA: {e}\")\nEOF\n"]
