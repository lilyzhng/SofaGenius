[32.132979, "i", "cat > /app/scripts/examine_excel.py << 'EOF'\nimport pandas as pd\nfrom openpyxl import load_workbook\n\n# Load the Excel file\ndata_file = \"/app/data/ConSup Inc Financial Model_PROMPT.xlsx\"\n\n# Get all sheet names\nwb = load_workbook(data_file)\nsheet_names = wb.sheetnames\nprint(\"Available sheets:\")\nfor name in sheet_names:\n    print(f\"  - {name}\")\n\n# Try to read a few sheets to see data structure\ntry:\n    # Read a few sheets to understand the data\n    for sheet in sheet_names[:3]:\n        try:\n            df = pd.read_excel(data_file, sheet_name=sheet)\n            print(f\"\\nSheet: {sheet}\")\n            print(f\"Shape: {df.shape}\")\n            print(f\"First 5 rows:\")\n            print(df.head())\n        except Exception as e:\n            print(f\"Could not read {sheet}: {e}\")\nexcept Exception as e:\n    print(f\"Error reading Excel file: {e}\")\nEOF\n"]
