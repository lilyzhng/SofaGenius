[94.17595, "i", "cat > /app/scripts/extract_key_data.py << 'EOF'\nimport pandas as pd\nfrom openpyxl import load_workbook\n\n# Load the Excel file\ndata_file = \"/app/data/ConSup Inc Financial Model_PROMPT.xlsx\"\n\n# Try to extract key data from Financial Statements\ntry:\n    df_financial = pd.read_excel(data_file, sheet_name=\"Financial Statements\", header=3)\n    \n    # Let's look at column names to identify EBITDA\n    print(\"Financial Statements column names:\")\n    for i, col in enumerate(df_financial.columns):\n        print(f\"  {i}: {col}\")\n    \n    # Find the Core Business row (which contains EBITDA data)\n    core_business_row = df_financial[df_financial.iloc[:, 0].str.contains('Core Business', na=False)]\n    if not core_business_row.empty:\n        print(f\"\\nCore Business row found at index: {core_business_row.index[0]}\")\n        core_business_data = core_business_row.iloc[0]\n        print(\"Core Business data:\")\n        print(core_business_data)\n    \n    # Extract the EBITDA values for FY24-FY29\n    # We need to look for the row that contains EBITDA data\n    ebitda_row = None\n    for idx, row in df_financial.iterrows():\n        if 'EBITDA' in str(row.iloc[0]) or 'Core Business' in str(row.iloc[0]):\n            ebitda_row = row\n            print(f\"\\nEBITDA/Core Business row found at index: {idx}\")\n            print(row)\n            break\n    \n    # Look at the actual values for EBITDA in each year\n    print(\"\\nExamining row data for EBITDA values:\")\n    for idx, row in df_financial.iterrows():\n        if not pd.isna(row.iloc[0]) and ('EBITDA' in str(row.iloc[0]) or 'Core' in str(row.iloc[0])):\n            print(f\"Row {idx}: {row.iloc[0]}\")\n            # Print the data values for this row\n            for i in range(1, len(row)):\n                if not pd.isna(row.iloc[i]):\n                    print(f\"  Year {i}: {row.iloc[i]}\")\n                    \nexcept Exception as e:\n    print(f\"Error extracting financial data: {e}\")\n\n# Now extract transaction details\ntry:\n    df_transaction = pd.read_excel(data_file, sheet_name=\"Transaction Structure\", header=3)\n    print(f\"\\nTransaction Structure data:\")\n    print(df_transaction.head(15))\n    \n    # Look for key transaction data\n    key_fields = ['FY24 EBITDA', 'Purchase Enterprise Value', 'Rollover Equity', 'Sponsor Equity']\n    for field in key_fields:\n        field_row = df_transaction[df_transaction.iloc[:, 0].str.contains(field, na=False)]\n        if not field_row.empty:\n            print(f\"\\n{field}: {field_row.iloc[0].iloc[1]}\")\n            \nexcept Exception as e:\n    print(f\"Error extracting transaction data: {e}\")\nEOF\n"]
