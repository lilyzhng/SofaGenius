Sending keys: ['cat > lbo_analysis_full.py << \'EOF\'\nimport pandas as pd\nimport numpy as np\n\n# Read the Excel file\nxl_file = \'/app/data/ConSup Inc Financial Model_PROMPT.xlsx\'\nxl = pd.ExcelFile(xl_file)\n\n# Function to find value by searching for a label\ndef find_value_by_label(df, label, col_offset=1):\n    for idx, row in df.iterrows():\n        if pd.notna(row.iloc[1]) and str(row.iloc[1]).strip() == label:\n            return row.iloc[1 + col_offset]\n    return None\n\n# Function to find value in specific location\ndef find_value_at_location(df, row_label, col_search=None):\n    for idx, row in df.iterrows():\n        if pd.notna(row.iloc[1]) and str(row.iloc[1]).strip() == row_label:\n            # Look for non-NaN values in this row\n            for col_idx in range(2, len(row)):\n                if pd.notna(row.iloc[col_idx]) and isinstance(row.iloc[col_idx], (int, float)):\n                    return row.iloc[col_idx]\n    return None\n\nprint("=== EXTRACTING KEY TRANSACTION DATA ===")\n\n# Read sheets\ntransaction_df = pd.read_excel(xl, \'Transaction Structure\')\nfinancials_df = pd.read_excel(xl, \'Financial Statements\')\nassumptions_df = pd.read_excel(xl, \'Assumptions\')\n\n# Look for key transaction values\nprint("\\nSearching for Purchase Enterprise Value...")\nfor idx, row in transaction_df.iterrows():\n    if pd.notna(row.iloc[1]) and \'Purchase Enterprise Value\' in str(row.iloc[1]):\n        print(f"Row {idx}: {row.iloc[1]} = {row.iloc[-1]}")\n\nprint("\\nSearching for equity values...")\nfor idx, row in transaction_df.iterrows():\n    if pd.notna(row.iloc[1]) and (\'Equity\' in str(row.iloc[1]) or \'equity\' in str(row.iloc[1])):\n        print(f"Row {idx}: {row.iloc[1]} = {row.iloc[-1] if pd.notna(row.iloc[-1]) else \'N/A\'}")\n\nprint("\\nSearching for EBITDA values in financials...")\nfor idx, row in financials_df.iterrows():\n    if pd.notna(row.iloc[1]) and \'EBITDA\' in str(row.iloc[1]):\n        print(f"Row {idx}: {[row.iloc[i] for i in range(min(8, len(row)))]")\n\nprint("\\nSearching for Payroll in financials...")\nfor idx, row in financials_df.iterrows():\n    if pd.notna(row.iloc[1]) and \'Payroll\' in str(row.iloc[1]):\n        print(f"Row {idx}: {[row.iloc[i] for i in range(min(8, len(row)))]")\n\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
