[?2004hroot@31fea87767f4:/app# cat > lbo_analysis.py << 'EOF'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> from datetime import datetime
[?2004l[?2004h> 
[?2004l[?2004h> # Key data from the model
[?2004l[?2004h> fy24_ebitda = 8318.254226224824
[?2004l[?2004h> ebitda_projections = [8085.172175400006, 7598.384048879094, 8318.254226224824, 
[?2004l[?2004h>                      8906.637713389122, 9303.029304349491, 10140.561173162932, 
[?2004l[?2004h>                      10838.830677772166, 11698.1344664997]
[?2004ll[?2004h> 
[?2004l_[?2004h> # Transaction structure (in $000s)
[?2004l[?2004h> senior_debt = 16636.508452
[?2004l[?2004h> subordinate_debt = 8318.254226
[?2004l[?2004h> total_debt = senior_debt + subordinate_debt
[?2004l[?2004h> rollover_equity = 6763.01211
[?2004l[?2004h> sponsor_equity = 38323.735289
[?2004l[?2004h> total_equity = rollover_equity + sponsor_equity
[?2004l[?2004h> entry_equity = total_equity
[?2004lce[?2004h> 
[?2004ln[?2004h> print("=== TPG LBO ANALYSIS ===")
[?2004l[?2004h> print(f"Entry Equity Investment: ${total_equity:,.0f}k")
[?2004l[?2004h> print(f"Entry Debt: ${total_debt:,.0f}k")
[?2004l[?2004h> print(f"FY24 EBITDA: ${fy24_ebitda:,.0f}k")
[?2004l[?2004h> 
[?2004l[?2004h> # Adjust EBITDA projections for 7% vs 5% payroll growth
[?2004l[?2004h> # Need to estimate payroll impact - assume payroll is ~30% of revenue
[?2004l[?2004h> # Revenue in FY24 was ~$31,379k, so payroll might be ~$9,400k
[?2004l[?2004h> # 2% additional growth on $9,400k = $188k impact growing each year
[?2004l[?2004h> payroll_base = 9400  # Estimated
[?2004l[?2004h> additional_payroll_impact = payroll_base * 0.02  # 2% additional growth
[?2004l[?2004h> 
[?2004lr[?2004h> # Adjust EBITDA projections (reduce EBITDA for higher payroll costs)
[?2004l[?2004h> adjusted_ebitda = ebitda_projections.copy()
[?2004l[?2004h> for i in range(4, len(adjusted_ebitda)):  # Start from FY25 (index 3)
[?2004lf equity value from Multiple[?2004h>     years_from_fy25 = i - 3
[?2004l[?2004h>     cumulative_impact = additional_payroll_impact * years_from_fy25 * (1.07 ** years_from_fy25)
[?2004l[?2004h>     adjusted_ebitda[i] -= cumulative_impact
[?2004l[?2004h> 
[?2004l[?2004h> print("\nAdjusted EBITDA Projections (7% vs 5% payroll growth):")
[?2004le[?2004h> years = ['FY22A', 'FY23A', 'FY24PF', 'FY25F', 'FY26F', 'FY27F', 'FY28F', 'FY29F']
[?2004l[?2004h> for i, year in enumerate(years):
[?2004l[?2004h>     print(f"{year}: ${adjusted_ebitda[i]:,.0f}k")
[?2004l[?2004h> 
[?2004l[?2004h> # Debt paydown assumptions - assume debt pays down based on cash flow
[?2004l[?2004h> # Simplified: assume 50% of excess cash flow goes to debt paydown
[?2004l[?2004h> debt_balances = [total_debt]
[?2004l[?2004h> for i in range(4, 8):  # FY25 to FY28
[?2004l[?2004h>     # Assume 50% of EBITDA above maintenance capex goes to debt paydown
[?2004l[?2004h>     cash_flow = adjusted_ebitda[i] * 0.6  # After taxes, capex, working capital
[?2004l[?2004h>     debt_paydown = cash_flow * 0.4
[?2004l[?2004h>     new_debt = max(0, debt_balances[-1] - debt_paydown)
[?2004l[?2004h>     debt_balances.append(new_debt)
[?2004l[?2004h> 
[?2004l[?2004h> print("\nDebt Balance Projections:")
[?2004l[?2004h> for i, year in enumerate(['Entry', 'FY25F', 'FY26F', 'FY27F', 'FY28F']):
[?2004l[?2004h>     print(f"{year}: ${debt_balances[i]:,.0f}k")
[?2004l[?2004h> 
[?2004l[?2004h> # Scenario 1: Exit FY28 at 15.0x EBITDA
[?2004l[?2004h> fy28_ebitda = adjusted_ebitda[6]
[?2004l[?2004h> fy28_exit_ev = fy28_ebitda * 15.0
[?2004l[?2004h> fy28_exit_debt = debt_balances[4]
[?2004l[?2004h> fy28_exit_equity = fy28_exit_ev - fy28_exit_debt
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\n=== SCENARIO 1: FY28 EXIT AT 15.0x ===")
[?2004l[?2004h> print(f"FY28 EBITDA: ${fy28_ebitda:,.0f}k")
[?2004l[?2004h> print(f"Exit Enterprise Value: ${fy28_exit_ev:,.0f}k")
[?2004l[?2004h> print(f"Exit Debt: ${fy28_exit_debt:,.0f}k")
[?2004l[?2004h> print(f"Exit Equity Value: ${fy28_exit_equity:,.0f}k")
[?2004l[?2004h> 
[?2004l[?2004h> # Scenario 2: Exit FY29 at 16.0x EBITDA  
[?2004l[?2004h> fy29_ebitda = adjusted_ebitda[7]
[?2004l[?2004h> # Extend debt paydown to FY29
[?2004l[?2004h> fy29_cash_flow = fy29_ebitda * 0.6
[?2004l[?2004h> fy29_debt_paydown = fy29_cash_flow * 0.4
[?2004l[?2004h> fy29_exit_debt = max(0, debt_balances[4] - fy29_debt_paydown)
[?2004l[?2004h> fy29_exit_ev = fy29_ebitda * 16.0
[?2004l[?2004h> fy29_exit_equity = fy29_exit_ev - fy29_exit_debt
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\n=== SCENARIO 2: FY29 EXIT AT 16.0x ===")
[?2004l[?2004h> print(f"FY29 EBITDA: ${fy29_ebitda:,.0f}k")
[?2004l[?2004h> print(f"Exit Enterprise Value: ${fy29_exit_ev:,.0f}k")
[?2004l[?2004h> print(f"Exit Debt: ${fy29_exit_debt:,.0f}k")
[?2004l[?2004h> print(f"Exit Equity Value: ${fy29_exit_equity:,.0f}k")
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate returns for both scenarios
[?2004l[?2004h> def calculate_returns(exit_equity, years_held, entry_equity):
[?2004l[?2004h>     # Waterfall: 8% preferred return, 5% management option pool, 20% carry
[?2004l[?2004h>     
[?2004l[?2004h>     # Step 1: Return invested equity
[?2004l[?2004h>     remaining_proceeds = exit_equity - entry_equity
[?2004l[?2004h>     
[?2004l[?2004h>     if remaining_proceeds <= 0:
[?2004l[?2004h>         return 0, 0, 0, 0, 0  # No returns
[?2004l[?2004h>     
[?2004l[?2004h>     # Step 2: 8% preferred return (compounded annually)
[?2004l[?2004h>     preferred_return = entry_equity * ((1.08 ** years_held) - 1)
[?2004l[?2004h>     remaining_after_pref = remaining_proceeds - preferred_return
[?2004l[?2004h>     
[?2004l[?2004h>     if remaining_after_pref <= 0:
[?2004l[?2004h>         irr = ((exit_equity / entry_equity) ** (1/years_held)) - 1
[?2004l[?2004h>         moic = exit_equity / entry_equity
[?2004l[?2004h>         return irr, moic, 0, 0, 0
[?2004l[?2004h>     
[?2004l[?2004h>     # Step 3: 5% management option pool
[?2004l[?2004h>     mgmt_options = remaining_after_pref * 0.05
[?2004l[?2004h>     profit_for_carry_calc = remaining_after_pref - mgmt_options
[?2004l[?2004h>     
[?2004l[?2004h>     # Step 4: 20% carry to GP
[?2004l[?2004h>     gp_carry = profit_for_carry_calc * 0.20
[?2004l[?2004h>     lp_profit = profit_for_carry_calc * 0.80
[?2004l[?2004h>     
[?2004l[?2004h>     # LP returns
[?2004l[?2004h>     lp_total_return = entry_equity + preferred_return + lp_profit
[?2004l[?2004h>     lp_irr = ((lp_total_return / entry_equity) ** (1/years_held)) - 1
[?2004l[?2004h>     lp_moic = lp_total_return / entry_equity
[?2004l[?2004h>     
[?2004l[?2004h>     return lp_irr, lp_moic, gp_carry, mgmt_options, profit_for_carry_calc
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate for both scenarios
[?2004l[?2004h> print("\n=== SCENARIO 1 RETURNS (FY28 EXIT) ===")
[?2004l[?2004h> s1_irr, s1_moic, s1_carry, s1_mgmt, s1_profit = calculate_returns(fy28_exit_equity, 4, entry_equity)
[?2004l[?2004h> print(f"Net IRR for LPs: {s1_irr:.2%}")
[?2004l[?2004h> print(f"Net MOIC for LPs: {s1_moic:.2f}x")
[?2004l[?2004h> print(f"Carry for GP: ${s1_carry:,.0f}k")
[?2004l[?2004h> 
[?2004l[?2004h> # Equity value creation analysis
[?2004l[?2004h> entry_ev = fy24_ebitda * (66546.033810 / fy24_ebitda)  # Entry multiple
[?2004l[?2004h> ebitda_growth_value = (fy28_ebitda - fy24_ebitda) * 15.0
[?2004l[?2004h> multiple_expansion_value = fy28_ebitda * (15.0 - (66546.033810 / fy24_ebitda))
[?2004l[?2004h> total_equity_created = s1_profit  # Net of mgmt options
[?2004l[?2004h> 
[?2004l[?2004h> print(f"% of equity value from EBITDA growth: {(ebitda_growth_value/total_equity_created)*100:.2f}%")
[?2004l[?2004h> print(f"% of equity value from Multiple Expansion: {(multiple_expansion_value/total_equity_created)*100:.2f}%")
[?2004l[?2004h> 
[?2004l[?2004h> print("\n=== SCENARIO 2 RETURNS (FY29 EXIT) ===")
[?2004l[?2004h> s2_irr, s2_moic, s2_carry, s2_mgmt, s2_profit = calculate_returns(fy29_exit_equity, 5, entry_equity)
[?2004l[?2004h> print(f"Net IRR for LPs: {s2_irr:.2%}")
[?2004l[?2004h> print(f"Net MOIC for LPs: {s2_moic:.2f}x")
[?2004l[?2004h> print(f"Carry for GP: ${s2_carry:,.0f}k")
[?2004l[?2004h> 
[?2004l[?2004h> # Equity value creation analysis for scenario 2
[?2004l[?2004h> ebitda_growth_value_s2 = (fy29_ebitda - fy24_ebitda) * 16.0
[?2004l[?2004h> multiple_expansion_value_s2 = fy29_ebitda * (16.0 - (66546.033810 / fy24_ebitda))
[?2004l[?2004h> total_equity_created_s2 = s2_profit
[?2004l[?2004h> 
[?2004l[?2004h> print(f"% of equity value from EBITDA growth: {(ebitda_growth_value_s2/total_equity_created_s2)*100:.2f}%")
[?2004l[?2004h> print(f"% of equity value from Multiple Expansion: {(multiple_expansion_value_s2/total_equity_created_s2)*100:.2f}%")
