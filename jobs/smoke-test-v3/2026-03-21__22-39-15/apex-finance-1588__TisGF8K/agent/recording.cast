[115.720028, "o", "years = ['FY22A', 'FY23A', 'FY24PF', 'FY25F', 'FY26F', 'FY27F', 'FY28F', 'FY29F']\r\n"]
[115.720065, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[115.72015, "o", "for i, year in enumerate(years):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.720278, "o", "    print(f\"{year}: ${adjusted_ebitda[i]:,.0f}k\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.720533, "o", "# Debt paydown assumptions - assume debt pays down based on cash flow\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.720694, "o", "# Simplified: assume 50% of excess cash flow goes to debt paydown\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.720802, "o", "debt_balances = [total_debt]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.720839, "o", "for i in range(4, 8):  # FY25 to FY28\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.721092, "o", "    # Assume 50% of EBITDA above maintenance capex goes to debt paydown\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.721238, "o", "    cash_flow = adjusted_ebitda[i] * 0.6  # After taxes, capex, working capital\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.721281, "o", "    debt_paydown = cash_flow * 0.4\r\n\u001b[?2004l\r\u001b[?2004h>     new_debt = max(0, debt_balances[-1] - debt_paydown)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.721425, "o", "    debt_balances.append(new_debt)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\nDebt Balance Projections:\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.721641, "o", "for i, year in enumerate(['Entry', 'FY25F', 'FY26F', 'FY27F', 'FY28F']):\r\n\u001b[?2004l\r\u001b[?2004h>     print(f\"{year}: ${debt_balances[i]:,.0f}k\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Scenario 1: Exit FY28 at 15.0x EBITDA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.721675, "o", "fy28_ebitda = adjusted_ebitda[6]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.721781, "o", "fy28_exit_ev = fy28_ebitda * 15.0\r\n\u001b[?2004l\r\u001b[?2004h> fy28_exit_debt = debt_balances[4]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.721974, "o", "fy28_exit_equity = fy28_exit_ev - fy28_exit_debt\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"\\n=== SCENARIO 1: FY28 EXIT AT 15.0x ===\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.722087, "o", "print(f\"FY28 EBITDA: ${fy28_ebitda:,.0f}k\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Exit Enterprise Value: ${fy28_exit_ev:,.0f}k\")\r\n\u001b[?2004l\r"]
[115.722182, "o", "\u001b[?2004h> print(f\"Exit Debt: ${fy28_exit_debt:,.0f}k\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.72224, "o", "print(f\"Exit Equity Value: ${fy28_exit_equity:,.0f}k\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.722264, "o", "# Scenario 2: Exit FY29 at 16.0x EBITDA  \r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.722471, "o", "fy29_ebitda = adjusted_ebitda[7]\r\n\u001b[?2004l\r\u001b[?2004h> # Extend debt paydown to FY29\r\n\u001b[?2004l\r\u001b[?2004h> fy29_cash_flow = fy29_ebitda * 0.6\r\n\u001b[?2004l\r"]
[115.722668, "o", "\u001b[?2004h> fy29_debt_paydown = fy29_cash_flow * 0.4\r\n\u001b[?2004l\r\u001b[?2004h> fy29_exit_debt = max(0, debt_balances[4] - fy29_debt_paydown)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.72277, "o", "fy29_exit_ev = fy29_ebitda * 16.0\r\n\u001b[?2004l\r\u001b[?2004h> fy29_exit_equity = fy29_exit_ev - fy29_exit_debt\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> print(f\"\\n=== SCENARIO 2: FY29 EXIT AT 16.0x ===\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.722803, "o", "print(f\"FY29 EBITDA: ${fy29_ebitda:,.0f}k\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Exit Enterprise Value: ${fy29_exit_ev:,.0f}k\")\r\n\u001b[?2004l\r"]
[115.722926, "o", "\u001b[?2004h> print(f\"Exit Debt: ${fy29_exit_debt:,.0f}k\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.723111, "o", "print(f\"Exit Equity Value: ${fy29_exit_equity:,.0f}k\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Calculate returns for both scenarios\r\n\u001b[?2004l\r\u001b[?2004h> def calculate_returns(exit_equity, years_held, entry_equity):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.723247, "o", "    # Waterfall: 8% preferred return, 5% management option pool, 20% carry\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.723384, "o", "    # Step 1: Return invested equity\r\n\u001b[?2004l\r\u001b[?2004h>     remaining_proceeds = exit_equity - entry_equity\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.723407, "o", "    if remaining_proceeds <= 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.723507, "o", "        return 0, 0, 0, 0, 0  # No returns\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.723662, "o", "    # Step 2: 8% preferred return (compounded annually)\r\n\u001b[?2004l\r\u001b[?2004h>     preferred_return = entry_equity * ((1.08 ** years_held) - 1)\r\n\u001b[?2004l\r"]
[115.723791, "o", "\u001b[?2004h>     remaining_after_pref = remaining_proceeds - preferred_return\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[115.723815, "o", "\u001b[?2004h> "]
[115.723971, "o", "    if remaining_after_pref <= 0:\r\n\u001b[?2004l\r\u001b[?2004h>         irr = ((exit_equity / entry_equity) ** (1/years_held)) - 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.723988, "o", "        moic = exit_equity / entry_equity\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.724074, "o", "        return irr, moic, 0, 0, 0\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.724151, "o", "    # Step 3: 5% management option pool\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.724227, "o", "    mgmt_options = remaining_after_pref * 0.05\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.724296, "o", "    profit_for_carry_calc = remaining_after_pref - mgmt_options\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.724326, "o", "    # Step 4: 20% carry to GP\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.724548, "o", "    gp_carry = profit_for_carry_calc * 0.20\r\n\u001b[?2004l\r\u001b[?2004h>     lp_profit = profit_for_carry_calc * 0.80\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.724724, "o", "    # LP returns\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.724844, "o", "    lp_total_return = entry_equity + preferred_return + lp_profit\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.724892, "o", "    lp_irr = ((lp_total_return / entry_equity) ** (1/years_held)) - 1\r\n\u001b[?2004l\r\u001b[?2004h>     lp_moic = lp_total_return / entry_equity\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[115.724936, "o", "> "]
[115.725203, "o", "    return lp_irr, lp_moic, gp_carry, mgmt_options, profit_for_carry_calc\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Calculate for both scenarios\r\n\u001b[?2004l\r\u001b[?2004h> print(\"\\n=== SCENARIO 1 RETURNS (FY28 EXIT) ===\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.725313, "o", "s1_irr, s1_moic, s1_carry, s1_mgmt, s1_profit = calculate_returns(fy28_exit_equity, 4, entry_equity)\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Net IRR for LPs: {s1_irr:.2%}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.725524, "o", "print(f\"Net MOIC for LPs: {s1_moic:.2f}x\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Carry for GP: ${s1_carry:,.0f}k\")\r\n\u001b[?2004l\r"]
[115.725631, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.725666, "o", "# Equity value creation analysis\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.725685, "o", "entry_ev = fy24_ebitda * (66546.033810 / fy24_ebitda)  # Entry multiple\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.725893, "o", "ebitda_growth_value = (fy28_ebitda - fy24_ebitda) * 15.0\r\n\u001b[?2004l\r\u001b[?2004h> multiple_expansion_value = fy28_ebitda * (15.0 - (66546.033810 / fy24_ebitda))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.726114, "o", "total_equity_created = s1_profit  # Net of mgmt options\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.726345, "o", "print(f\"% of equity value from EBITDA growth: {(ebitda_growth_value/total_equity_created)*100:.2f}%\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.726376, "o", "print(f\"% of equity value from Multiple Expansion: {(multiple_expansion_value/total_equity_created)*100:.2f}%\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[115.726456, "o", "\u001b[?2004h> "]
[115.726526, "o", "print(\"\\n=== SCENARIO 2 RETURNS (FY29 EXIT) ===\")\r\n\u001b[?2004l\r"]
[115.726591, "o", "\u001b[?2004h> "]
[115.726785, "o", "s2_irr, s2_moic, s2_carry, s2_mgmt, s2_profit = calculate_returns(fy29_exit_equity, 5, entry_equity)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.726876, "o", "print(f\"Net IRR for LPs: {s2_irr:.2%}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.727069, "o", "print(f\"Net MOIC for LPs: {s2_moic:.2f}x\")\r\n\u001b[?2004l\r\u001b[?2004h> print(f\"Carry for GP: ${s2_carry:,.0f}k\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.727246, "o", "# Equity value creation analysis for scenario 2\r\n\u001b[?2004l\r"]
[115.727336, "o", "\u001b[?2004h> "]
[115.727362, "o", "ebitda_growth_value_s2 = (fy29_ebitda - fy24_ebitda) * 16.0\r\n\u001b[?2004l\r"]
[115.727503, "o", "\u001b[?2004h> "]
[115.727633, "o", "multiple_expansion_value_s2 = fy29_ebitda * (16.0 - (66546.033810 / fy24_ebitda))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.727662, "o", "total_equity_created_s2 = s2_profit\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.727855, "o", "print(f\"% of equity value from EBITDA growth: {(ebitda_growth_value_s2/total_equity_created_s2)*100:.2f}%\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[115.727981, "o", "print(f\"% of equity value from Multiple Expansion: {(multiple_expansion_value_s2/total_equity_created_s2)*100:.2f}%\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[115.728935, "o", "\u001b[?2004hroot@31fea87767f4:/app# "]
