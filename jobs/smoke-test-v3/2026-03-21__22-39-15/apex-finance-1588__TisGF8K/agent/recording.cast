[64.194994, "i", "cat > extract_full_data.py << 'EOF'\nimport pandas as pd\nimport numpy as np\n\n# Read Excel file\nxl_file = '/app/data/ConSup Inc Financial Model_PROMPT.xlsx'\n\nprint(\"=== EXTRACTING FULL MODEL DATA ===\")\n\n# Transaction Structure\ntrans_df = pd.read_excel(xl_file, sheet_name='Transaction Structure', header=None)\n\n# Key transaction metrics\nprint(\"\\nTransaction Structure:\")\nprint(f\"FY24 EBITDA: ${trans_df.iloc[5, 8]:,.0f}k\")\nprint(f\"Purchase Enterprise Value: ${trans_df.iloc[5, 12]:,.0f}k\")\nprint(f\"Senior Debt: ${trans_df.iloc[5, 8]:,.0f}k\")\nprint(f\"Subordinate Debt: ${trans_df.iloc[6, 8]:,.0f}k\")\nprint(f\"Rollover Equity: ${trans_df.iloc[7, 8]:,.0f}k\")\nprint(f\"Sponsor Equity: ${trans_df.iloc[8, 8]:,.0f}k\")\n\n# Financial projections\nfinancial_df = pd.read_excel(xl_file, sheet_name='Financial Statements', header=None)\n\n# Get EBITDA projections - extend to see if FY2029 exists\nprint(\"\\nEBITDA Projections:\")\nebitda_row = 30  # Found earlier\nprint(\"Years:\", financial_df.iloc[5, 5:15].tolist())\nprint(\"EBITDA:\", financial_df.iloc[ebitda_row, 5:15].tolist())\n\n# Check Debt sheet\nprint(\"\\n=== DEBT STRUCTURE ===\")\ndebt_df = pd.read_excel(xl_file, sheet_name='Debt', header=None)\nprint(\"Debt sheet preview:\")\nprint(debt_df.iloc[0:20, 0:8].to_string())\n\n# Look for more transaction details\nprint(\"\\n=== MORE TRANSACTION DETAILS ===\")\nfor i in range(20, 40):\n    if i < trans_df.shape[0]:\n        if pd.notna(trans_df.iloc[i, 1]):\n            row_vals = trans_df.iloc[i, 8:13].tolist()\n            if any(pd.notna(val) and val != 0 for val in row_vals):\n                print(f\"Row {i}: {trans_df.iloc[i, 1]} - {row_vals}\")\nEOF\n"]
[64.195351, "o", "cat > extract_full_data.py << 'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
