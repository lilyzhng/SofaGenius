[115.715097, "i", "cat > lbo_analysis.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom datetime import datetime\n\n# Key data from the model\nfy24_ebitda = 8318.254226224824\nebitda_projections = [8085.172175400006, 7598.384048879094, 8318.254226224824, \n                     8906.637713389122, 9303.029304349491, 10140.561173162932, \n                     10838.830677772166, 11698.1344664997]\n\n# Transaction structure (in $000s)\nsenior_debt = 16636.508452\nsubordinate_debt = 8318.254226\ntotal_debt = senior_debt + subordinate_debt\nrollover_equity = 6763.01211\nsponsor_equity = 38323.735289\ntotal_equity = rollover_equity + sponsor_equity\nentry_equity = total_equity\n\nprint(\"=== TPG LBO ANALYSIS ===\")\nprint(f\"Entry Equity Investment: ${total_equity:,.0f}k\")\nprint(f\"Entry Debt: ${total_debt:,.0f}k\")\nprint(f\"FY24 EBITDA: ${fy24_ebitda:,.0f}k\")\n\n# Adjust EBITDA projections for 7% vs 5% payroll growth\n# Need to estimate payroll impact - assume payroll is ~30% of revenue\n# Revenue in FY24 was ~$31,379k, so payroll might be ~$9,400k\n# 2% additional growth on $9,400k = $188k impact growing each year\npayroll_base = 9400  # Estimated\nadditional_payroll_impact = payroll_base * 0.02  # 2% additional growth\n\n# Adjust EBITDA projections (reduce EBITDA for higher payroll costs)\nadjusted_ebitda = ebitda_projections.copy()\nfor i in range(4, len(adjusted_ebitda)):  # Start from FY25 (index 3)\n    years_from_fy25 = i - 3\n    cumulative_impact = additional_payroll_impact * years_from_fy25 * (1.07 ** years_from_fy25)\n    adjusted_ebitda[i] -= cumulative_impact\n\nprint(\"\\nAdjusted EBITDA Projections (7% vs 5% payroll growth):\")\nyears = ['FY22A', 'FY23A', 'FY24PF', 'FY25F', 'FY26F', 'FY27F', 'FY28F', 'FY29F']\nfor i, year in enumerate(years):\n    print(f\"{year}: ${adjusted_ebitda[i]:,.0f}k\")\n\n# Debt paydown assumptions - assume debt pays down based on cash flow\n# Simplified: assume 50% of excess cash flow goes to debt paydown\ndebt_balances = [total_debt]\nfor i in range(4, 8):  # FY25 to FY28\n    # Assume 50% of EBITDA above maintenance capex goes to debt paydown\n    cash_flow = adjusted_ebitda[i] * 0.6  # After taxes, capex, working capital\n    debt_paydown = cash_flow * 0.4\n    new_debt = max(0, debt_balances[-1] - debt_paydown)\n    debt_balances.append(new_debt)\n\nprint(\"\\nDebt Balance Projections:\")\nfor i, year in enumerate(['Entry', 'FY25F', 'FY26F', 'FY27F', 'FY28F']):\n    print(f\"{year}: ${debt_balances[i]:,.0f}k\")\n\n# Scenario 1: Exit FY28 at 15.0x EBITDA\nfy28_ebitda = adjusted_ebitda[6]\nfy28_exit_ev = fy28_ebitda * 15.0\nfy28_exit_debt = debt_balances[4]\nfy28_exit_equity = fy28_exit_ev - fy28_exit_debt\n\nprint(f\"\\n=== SCENARIO 1: FY28 EXIT AT 15.0x ===\")\nprint(f\"FY28 EBITDA: ${fy28_ebitda:,.0f}k\")\nprint(f\"Exit Enterprise Value: ${fy28_exit_ev:,.0f}k\")\nprint(f\"Exit Debt: ${fy28_exit_debt:,.0f}k\")\nprint(f\"Exit Equity Value: ${fy28_exit_equity:,.0f}k\")\n\n# Scenario 2: Exit FY29 at 16.0x EBITDA  \nfy29_ebitda = adjusted_ebitda[7]\n# Extend debt paydown to FY29\nfy29_cash_flow = fy29_ebitda * 0.6\nfy29_debt_paydown = fy29_cash_flow * 0.4\nfy29_exit_debt = max(0, debt_balances[4] - fy29_debt_paydown)\nfy29_exit_ev = fy29_ebitda * 16.0\nfy29_exit_equity = fy29_exit_ev - fy29_exit_debt\n\nprint(f\"\\n=== SCENARIO 2: FY29 EXIT AT 16.0x ===\")\nprint(f\"FY29 EBITDA: ${fy29_ebitda:,.0f}k\")\nprint(f\"Exit Enterprise Value: ${fy29_exit_ev:,.0f}k\")\nprint(f\"Exit Debt: ${fy29_exit_debt:,.0f}k\")\nprint(f\"Exit Equity Value: ${fy29_exit_equity:,.0f}k\")\n\n# Calculate returns for both scenarios\ndef calculate_returns(exit_equity, years_held, entry_equity):\n    # Waterfall: 8% preferred return, 5% management option pool, 20% carry\n    \n    # Step 1: Return invested equity\n    remaining_proceeds = exit_equity - entry_equity\n    \n    if remaining_proceeds <= 0:\n        return 0, 0, 0, 0, 0  # No returns\n    \n    # Step 2: 8% preferred return (compounded annually)\n    preferred_return = entry_equity * ((1.08 ** years_held) - 1)\n    remaining_after_pref = remaining_proceeds - preferred_return\n    \n    if remaining_after_pref <= 0:\n        irr = ((exit_equity / entry_equity) ** (1/years_held)) - 1\n        moic"]
[115.715254, "i", " = exit_equity / entry_equity\n        return irr, moic, 0, 0, 0\n    \n    # Step 3: 5% management option pool\n    mgmt_options = remaining_after_pref * 0.05\n    profit_for_carry_calc = remaining_after_pref - mgmt_options\n    \n    # Step 4: 20% carry to GP\n    gp_carry = profit_for_carry_calc * 0.20\n    lp_profit = profit_for_carry_calc * 0.80\n    \n    # LP returns\n    lp_total_return = entry_equity + preferred_return + lp_profit\n    lp_irr = ((lp_total_return / entry_equity) ** (1/years_held)) - 1\n    lp_moic = lp_total_return / entry_equity\n    \n    return lp_irr, lp_moic, gp_carry, mgmt_options, profit_for_carry_calc\n\n# Calculate for both scenarios\nprint(\"\\n=== SCENARIO 1 RETURNS (FY28 EXIT) ===\")\ns1_irr, s1_moic, s1_carry, s1_mgmt, s1_profit = calculate_returns(fy28_exit_equity, 4, entry_equity)\nprint(f\"Net IRR for LPs: {s1_irr:.2%}\")\nprint(f\"Net MOIC for LPs: {s1_moic:.2f}x\")\nprint(f\"Carry for GP: ${s1_carry:,.0f}k\")\n\n# Equity value creation analysis\nentry_ev = fy24_ebitda * (66546.033810 / fy24_ebitda)  # Entry multiple\nebitda_growth_value = (fy28_ebitda - fy24_ebitda) * 15.0\nmultiple_expansion_value = fy28_ebitda * (15.0 - (66546.033810 / fy24_ebitda))\ntotal_equity_created = s1_profit  # Net of mgmt options\n\nprint(f\"% of equity value from EBITDA growth: {(ebitda_growth_value/total_equity_created)*100:.2f}%\")\nprint(f\"% of equity value from Multiple Expansion: {(multiple_expansion_value/total_equity_created)*100:.2f}%\")\n\nprint(\"\\n=== SCENARIO 2 RETURNS (FY29 EXIT) ===\")\ns2_irr, s2_moic, s2_carry, s2_mgmt, s2_profit = calculate_returns(fy29_exit_equity, 5, entry_equity)\nprint(f\"Net IRR for LPs: {s2_irr:.2%}\")\nprint(f\"Net MOIC for LPs: {s2_moic:.2f}x\")\nprint(f\"Carry for GP: ${s2_carry:,.0f}k\")\n\n# Equity value creation analysis for scenario 2\nebitda_growth_value_s2 = (fy29_ebitda - fy24_ebitda) * 16.0\nmultiple_expansion_value_s2 = fy29_ebitda * (16.0 - (66546.033810 / fy24_ebitda))\ntotal_equity_created_s2 = s2_profit\n\nprint(f\"% of equity value from EBITDA growth: {(ebitda_growth_value_s2/total_equity_created_s2)*100:.2f}%\")\nprint(f\"% of equity value from Multiple Expansion: {(multiple_expansion_value_s2/total_equity_created_s2)*100:.2f}%\")\nEOF\n"]
