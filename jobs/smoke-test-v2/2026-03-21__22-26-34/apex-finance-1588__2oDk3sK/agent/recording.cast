[26.185437, "i", "cat > analyze_lbo.py << 'EOF'\nimport pandas as pd\nimport numpy as np\n\n# Load the Excel file\nxl = pd.ExcelFile('data/ConSup Inc Financial Model_PROMPT.xlsx')\n\nprint(\"=== EXAMINING TRANSACTION STRUCTURE ===\")\ntx_df = pd.read_excel(xl, 'Transaction Structure', header=None)\nprint(tx_df.iloc[0:30, 0:5].to_string())\n\nprint(\"\\n=== EXAMINING ASSUMPTIONS ===\")\nassump_df = pd.read_excel(xl, 'Assumptions', header=None)\nprint(assump_df.iloc[0:30, 0:5].to_string())\n\nprint(\"\\n=== EXAMINING FINANCIAL STATEMENTS ===\")\nfs_df = pd.read_excel(xl, 'Financial Statements', header=None)\nprint(fs_df.iloc[0:20, 0:8].to_string())\nEOF\n"]
