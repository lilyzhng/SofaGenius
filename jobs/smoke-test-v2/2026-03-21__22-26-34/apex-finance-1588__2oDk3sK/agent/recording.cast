[45.058752, "i", "cat > detailed_analysis.py << 'EOF'\nimport pandas as pd\nimport numpy as np\n\n# Load the Excel file\nxl = pd.ExcelFile('data/ConSup Inc Financial Model_PROMPT.xlsx')\n\nprint(\"=== KEY DEAL PARAMETERS ===\")\ntx_df = pd.read_excel(xl, 'Transaction Structure', header=None)\nprint(f\"FY24 EBITDA: ${tx_df.iloc[5,4]:,.0f}k\")\nprint(f\"Purchase Multiple: {tx_df.iloc[6,4]:.1f}x\")\nprint(f\"Senior Debt/EBITDA: {tx_df.iloc[7,4]:.1f}x\")\nprint(f\"Sub Debt/EBITDA: {tx_df.iloc[8,4]:.1f}x\")\nprint(f\"Rollover Equity: {tx_df.iloc[9,4]:.1%}\")\nprint(f\"Purchase Enterprise Value: ${tx_df.iloc[19,4]:,.0f}k\")\nprint(f\"Purchase Equity Value: ${tx_df.iloc[22,4]:,.0f}k\")\n\nprint(\"\\n=== EXAMINING MORE FINANCIAL PROJECTIONS ===\")\nfs_df = pd.read_excel(xl, 'Financial Statements', header=None)\n# Look for years beyond 2024\nfor i in range(40):\n    if i < len(fs_df):\n        row = fs_df.iloc[i, :]\n        if any(pd.notna(row)) and len(str(row).strip()) > 0:\n            print(f\"Row {i}: {row.iloc[0:8].values}\")\n            \nprint(\"\\n=== EXAMINING DEBT STRUCTURE ===\")\ndebt_df = pd.read_excel(xl, 'Debt', header=None)\nprint(debt_df.iloc[0:20, 0:8].to_string())\nEOF\n"]
